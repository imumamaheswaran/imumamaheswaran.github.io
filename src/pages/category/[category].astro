---
// Same URLs as WordPress category archives: /category/<name>/
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { type Post, getPosts, slugify } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const groups = new Map<string, { name: string; posts: Post[] }>();
	for (const post of posts) {
		for (const name of post.data.categories) {
			const slug = slugify(name);
			if (!slug) continue;
			const g = groups.get(slug) ?? { name, posts: [] };
			g.posts.push(post);
			groups.set(slug, g);
		}
	}
	return [...groups.entries()].map(([category, g]) => ({ params: { category }, props: g }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base title={name} description={`Notes about ${name}.`}>
	<p class="muted"><a href="/blog/">← All notes</a></p>
	<h1>{name}</h1>
	<p class="muted">{posts.length} {posts.length === 1 ? 'note' : 'notes'}</p>
	<PostList posts={posts} />
</Base>
