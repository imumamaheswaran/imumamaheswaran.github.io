---
// Posts live at the same URLs they had on WordPress: /YYYY/MM/DD/slug/
import { render } from 'astro:content';
import BlogPost from '../../../../layouts/BlogPost.astro';
import { type Post, getPosts, postParams } from '../../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	// Newest first, so the newer note is the one before.
	return posts.map((post, i) => ({
		params: postParams(post),
		props: { post, newer: posts[i - 1], older: posts[i + 1], number: posts.length - i },
	}));
}

const { post, newer, older, number } = Astro.props as { post: Post; newer?: Post; older?: Post; number: number };
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} newer={newer} older={older} number={number}>
	<Content />
</BlogPost>
