---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Architecture from '../components/Architecture.astro';
import BeltRack from '../components/BeltRack.astro';
import Bookshelf from '../components/Bookshelf.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { SOCIAL_LINKS } from '../consts';

const posts = await getPosts();
const latest = posts.slice(0, 4);
---

<Base wide>
	<Hero />

	<Architecture />

	<BeltRack />

	<Bookshelf />

	<section class="writing" aria-labelledby="writing-heading" data-reveal>
		<div class="row">
			<div>
				<p class="kicker">Writing</p>
				<h2 id="writing-heading">Latest posts</h2>
			</div>
			<a class="all" href="/blog/">All {posts.length} posts →</a>
		</div>
		<PostList posts={latest} />
	</section>

	<section class="hello" aria-labelledby="hello-heading" data-reveal>
		<h2 id="hello-heading">Say hello.</h2>
		<ul>
			{
				SOCIAL_LINKS.map((l) => (
					<li>
						<a href={l.href} rel="me noopener" target="_blank">
							{l.label} <span aria-hidden="true">↗</span>
						</a>
					</li>
				))
			}
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</section>
</Base>

<style>
	h2 {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.25rem);
	}
	.writing {
		margin: 6rem 0;
	}
	.writing :global(.post-list) {
		max-width: 50rem;
	}
	.row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.all {
		font-weight: 700;
		white-space: nowrap;
	}
	.hello {
		text-align: center;
		margin: 6rem auto 4rem;
	}
	.hello ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
	}
	.hello a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
	}
	.hello a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
