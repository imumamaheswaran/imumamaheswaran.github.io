---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Recommendations from '../components/Recommendations.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import HowIWork from '../components/HowIWork.astro';
import Subscribe from '../components/Subscribe.astro';

const posts = await getPosts();
const latest = posts.slice(0, 4);
---

<Base wide>
	<Hero />

	<section class="writing" aria-labelledby="writing-heading" data-reveal>
		<p class="kicker"><span class="n">01</span> Notes</p>
		<div class="row">
			<h2 id="writing-heading">Latest notes.</h2>
			<a class="all" href="/blog/">All {posts.length} notes →</a>
		</div>
		<div class="notes">
			<PostList posts={latest} />
			<Subscribe layout="line" />
		</div>
	</section>

	<HowIWork n="02" />

	<Recommendations n="03" />

</Base>

<style>
	h2 {
		margin: 0;
		font-size: clamp(1.9rem, 4.5vw, 3rem);
	}
	.writing {
		margin: 0 0 7rem;
	}
	.row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2rem;
		max-width: 52rem;
	}
	.notes {
		max-width: 52rem;
	}
	.all {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--blue);
		text-decoration: none;
	}
	.all:hover {
		color: var(--accent);
	}
</style>
