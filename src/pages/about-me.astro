---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SOCIAL_LINKS } from '../consts';
import Email from '../components/Email.astro';
import portrait from '../assets/about/portrait.png';
---

<Base title="About" description="Software architect and engineering manager in India, 15+ years building platforms in .NET, React and Azure/AWS. Taekwondo black belt." wide>
	<section class="about">
		<p class="kicker bare"><span class="n">●</span> About</p>
		<h1>I architect the platforms <br class="br" />that other teams build on.</h1>

		<div class="layout">
			<div class="story">
				<p class="lead">
					I'm a <strong>Technical Architect and Engineering Manager</strong> working remotely from India, with <strong>15+ years</strong> building platforms in .NET, React and Azure/AWS.
				</p>
				<p>
					At Provus I <strong>architected and built CPQ Express</strong>, a platform for pricing and
					quoting. Before that I <strong>moved critical services to AWS</strong> at Definitive Healthcare,
					ran a <strong>data platform answering 95% of queries in under 200 ms</strong> at Conga, and led
					the team that shipped <strong>Atomic Scope and Document360</strong> at Kovai.co.
				</p>
				<p>
					I started out writing data jobs and APIs at Lightcast. That's why I'm comfortable both <strong>drawing the boxes and writing the code inside them</strong>. I hold MCSD and MCSA
					certifications.
				</p>
				<p>
					Outside work I <strong>mentor developers</strong>, write on this blog (since 2016), and train
					in <strong>Taekwondo</strong>, where I hold a black belt. The discipline from the mat shapes how
					I approach code.
				</p>
				<p class="mail"><Email copy /></p>
				<p class="links">
					<a href="/blog/">Read my writing →</a>
					{
						SOCIAL_LINKS.map((l) => (
							<a href={l.href} rel="me noopener" target="_blank">
								{l.label} ↗
							</a>
						))
					}
				</p>
			</div>

			<figure class="portrait">
				<svg class="brush" viewBox="0 0 200 200" aria-hidden="true">
					<defs>
						<filter id="rough" x="-10%" y="-10%" width="120%" height="120%">
							<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="4"></feTurbulence>
							<feDisplacementMap in="SourceGraphic" scale="12"></feDisplacementMap>
						</filter>
					</defs>
					<circle class="disc" cx="100" cy="100" r="84" filter="url(#rough)"></circle>
					<circle class="ring" cx="100" cy="100" r="90" filter="url(#rough)"></circle>
				</svg>
				<Image
					src={portrait}
					alt="Umamaheswaran in sunglasses and a hoodie"
					widths={[400, 796]}
					sizes="(max-width: 820px) 80vw, 28rem"
					loading="eager"
				/>
				<figcaption>Fig. 2 — The real one</figcaption>
			</figure>
		</div>
	</section>
</Base>

<style>
	.about {
		padding: 1.5rem 0 3rem;
	}
	.kicker {
		margin-bottom: 1.5rem;
	}
	h1 {
		max-width: 22ch;
		margin: 0 0 3.5rem;
		font-size: clamp(2.4rem, 6.5vw, 5rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1;
		animation: rise 0.9s var(--ease-out) both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}
	.story p {
		margin: 0 0 1.4rem;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.75;
	}
	.story strong {
		color: var(--text);
		font-weight: 600;
	}
	.story .lead {
		color: var(--text);
		font-size: clamp(1.25rem, 2.4vw, 1.5rem);
		line-height: 1.5;
		letter-spacing: -0.015em;
	}
	.mail {
		margin: 0 0 1rem;
		font-weight: 600;
	}
	.mail :global(a) {
		color: var(--text);
		text-decoration-color: var(--accent);
		text-underline-offset: 0.25em;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}
	.links a {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}

	/* Cut-out portrait on a hand-brushed disc. */
	.portrait {
		position: relative;
		margin: 0;
		padding: 2rem 0 0;
		animation: rise 1s var(--ease-out) 0.2s both;
	}
	.brush {
		position: absolute;
		inset: -6% 4% auto;
		width: 92%;
		height: auto;
		overflow: visible;
		animation: spin 60s linear infinite;
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	.disc {
		fill: color-mix(in srgb, var(--blue) 18%, var(--bg));
	}
	.ring {
		fill: none;
		stroke: color-mix(in srgb, var(--blue) 35%, transparent);
		stroke-width: 1.5;
		stroke-dasharray: 3 5;
	}
	.portrait :global(img) {
		position: relative;
		display: block;
		width: 88%;
		margin: 0 auto;
		height: auto;
		border-radius: 0;
		filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.25));
	}
	figcaption {
		margin-top: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
		text-align: center;
	}

	@media (max-width: 820px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.portrait {
			grid-row: 1;
			width: min(80%, 22rem);
			justify-self: center;
		}
		.br {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.brush {
			animation: none;
		}
	}
</style>
