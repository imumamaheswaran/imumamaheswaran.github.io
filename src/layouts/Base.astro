---
import '../styles/global.css';
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KickBuddy from '../components/KickBuddy.astro';
import Kihap from '../components/Kihap.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	/** Describes the share image, for screen readers and link previews. */
	imageAlt?: string;
	type?: 'website' | 'article';
	/** Article details, for link previews and search engines. */
	article?: {
		published: Date;
		modified?: Date;
		section?: string;
		tags?: string[];
	};
	/** Use the wider page width (home page). */
	wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, imageAlt, type = 'website', article, wide = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const AUTHOR = 'Umamaheswaran';
const X_HANDLE = '@imumamaheswaran';

// The share image: the post's own image at 1200px wide, or the site card.
const og = image
	? await (async () => {
			const img = await getImage({ src: image, width: 1200, format: 'jpg' });
			return {
				url: new URL(img.src, Astro.site),
				width: Number(img.attributes.width ?? 1200),
				height: Number(img.attributes.height ?? Math.round((1200 * image.height) / image.width)),
				type: 'image/jpeg',
				alt: imageAlt ?? title ?? SITE_TITLE,
			};
		})()
	: {
			url: new URL('/og.png', Astro.site),
			width: 1200,
			height: 630,
			type: 'image/png',
			alt: `${SITE_TITLE}: notes on software architecture, .NET, React and AI`,
		};

// Structured data: a BlogPosting for notes; the site and its author elsewhere.
const person = {
	'@type': 'Person',
	name: AUTHOR,
	url: new URL('/about-me/', Astro.site).href,
	jobTitle: 'Technical Architect',
	sameAs: SOCIAL_LINKS.map((l) => l.href),
};
const jsonLd =
	type === 'article' && article
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: [og.url.href],
				datePublished: article.published.toISOString(),
				dateModified: (article.modified ?? article.published).toISOString(),
				author: person,
				publisher: person,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
				...(article.section ? { articleSection: article.section } : {}),
				...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
				inLanguage: 'en',
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: new URL('/', Astro.site).href,
				description: SITE_DESCRIPTION,
				inLanguage: 'en',
				author: person,
			};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
		<link rel="canonical" href={canonicalURL} />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={AUTHOR} />
		<meta name="robots" content="index, follow, max-image-preview:large" />

		{/* Link previews: Open Graph (LinkedIn, WhatsApp, Slack, Facebook) */}
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="en_IN" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={og.url} />
		<meta property="og:image:secure_url" content={og.url} />
		<meta property="og:image:type" content={og.type} />
		<meta property="og:image:width" content={String(og.width)} />
		<meta property="og:image:height" content={String(og.height)} />
		<meta property="og:image:alt" content={og.alt} />
		{
			article && (
				<Fragment>
					<meta property="article:published_time" content={article.published.toISOString()} />
					<meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
					<meta property="article:author" content={new URL('/about-me/', Astro.site).href} />
					{article.section && <meta property="article:section" content={article.section} />}
					{article.tags?.map((t) => <meta property="article:tag" content={t} />)}
				</Fragment>
			)
		}

		{/* X (Twitter) card */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={X_HANDLE} />
		<meta name="twitter:creator" content={X_HANDLE} />
		<meta name="twitter:title" content={title ?? SITE_TITLE} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={og.url} />
		<meta name="twitter:image:alt" content={og.alt} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<script is:inline>
			// Apply the saved light/dark choice before the page paints, and again
			// after each client-side page change (which replaces <html> attributes).
			(function () {
				function apply(doc) {
					var root = doc.documentElement;
					root.classList.add('js');
					try {
						var t = localStorage.getItem('theme');
						if (t === 'light' || t === 'dark') root.dataset.theme = t;
					} catch (e) {}
				}
				apply(document);
				if (!window.__themeSwap) {
					window.__themeSwap = true;
					document.addEventListener('astro:before-swap', function (e) {
						apply(e.newDocument);
					});
				}
			})();
		</script>
		<ClientRouter />
	</head>
	<body class:list={{ 'grid-paper': wide }}>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main" class:list={['container', { wide }]}>
			<slot />
		</main>
		<Footer />
		<KickBuddy />
		<Kihap />
		<script>
			// Fade sections in as they scroll into view ("bow in").
			function reveal() {
				const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)');
				if (!('IntersectionObserver' in window)) {
					els.forEach((el) => el.classList.add('in'));
					return;
				}
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
				);
				els.forEach((el) => {
					el.querySelectorAll<HTMLElement>('[data-stagger] > *').forEach((c, i) => c.style.setProperty('--d', `${i * 80}ms`));
					io.observe(el);
				});
			}
			document.addEventListener('astro:page-load', reveal);
		</script>
	</body>
</html>
