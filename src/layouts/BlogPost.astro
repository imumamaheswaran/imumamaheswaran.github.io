---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArchivedComments from '../components/ArchivedComments.astro';
import { type Post, categoryUrl, readingTime } from '../lib/posts';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, categories, wordpressId } = post.data;
const minutes = readingTime(post.body);
const showUpdated = updatedDate && updatedDate.valueOf() - pubDate.valueOf() > 7 * 24 * 3600 * 1000;
---

<Base title={title} description={description} image={heroImage} type="article">
	<article>
		<header class="post-header">
			<p class="meta">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>{minutes} min read</span>
			</p>
			<h1>{title}</h1>
			{
				categories.length > 0 && (
					<ul class="categories" aria-label="Categories">
						{categories.map((c) => (
							<li>
								<a href={categoryUrl(c)}>{c}</a>
							</li>
						))}
					</ul>
				)
			}
			{
				showUpdated && (
					<p class="updated muted">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		{heroImage && <Image class="hero" src={heroImage} alt="" width={1344} loading="eager" />}
		<div class="prose">
			<slot />
		</div>
	</article>
	<ArchivedComments wordpressId={wordpressId} />
</Base>

<style>
	.post-header {
		margin-bottom: 2rem;
	}
	.meta {
		color: var(--muted);
		font-size: 0.95rem;
		margin-bottom: 0.5rem;
		display: flex;
		gap: 0.5rem;
	}
	h1 {
		margin-bottom: 0.75rem;
	}
	.categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.categories a {
		display: inline-block;
		font-size: 0.85rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: var(--accent-soft);
		text-decoration: none;
	}
	.updated {
		font-size: 0.9rem;
		margin: 0.75rem 0 0;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 10px;
		margin-bottom: 2rem;
	}
	.prose :global(h2:first-child),
	.prose :global(h3:first-child) {
		margin-top: 0;
	}
	.prose :global(li) {
		margin-bottom: 0.35em;
	}
</style>
