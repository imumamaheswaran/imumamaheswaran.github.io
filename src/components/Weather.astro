---
/**
 * Live weather and local time where I am: Attur, Tamil Nadu. Data comes from
 * Open-Meteo (free, no key) in the visitor's browser; only Attur's fixed
 * coordinates are sent. Falls back to plain text if the request fails.
 */
---

<p class="wx" data-wx>
	<svg class="wx-icon" viewBox="0 0 24 24" aria-hidden="true" data-wx-icon>
		<circle cx="12" cy="12" r="4"></circle>
	</svg>
	<span>Attur, Tamil Nadu</span>
	<span class="sep" aria-hidden="true">·</span>
	<span data-wx-temp hidden></span>
	<span class="sep" aria-hidden="true" data-wx-sep hidden>·</span>
	<span data-wx-time></span>
</p>

<script>
	const LAT = 11.597;
	const LON = 78.601;
	const KEY = 'wx-attur';
	const TTL = 15 * 60 * 1000;

	// Small line icons, drawn on a 24×24 grid.
	const ICONS: Record<string, string> = {
		sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
		moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
		partly: '<path d="M8 3v1.5M3.5 8H5M4.8 4.8l1 1M11.2 4.8l-1 1"/><path d="M5.5 10.5a3 3 0 0 1 5.6-1.4"/><path d="M7 19h10a4 4 0 0 0 0-8 5 5 0 0 0-9.6 1.6A3.2 3.2 0 0 0 7 19z"/>',
		cloud: '<path d="M6 19h11a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.5 2A3.5 3.5 0 0 0 6 19z"/>',
		fog: '<path d="M4 9h16M3 13h18M5 17h14"/>',
		rain: '<path d="M6 15h11a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.5 2A3.5 3.5 0 0 0 6 15z"/><path d="M8 18l-1 3M12 18l-1 3M16 18l-1 3"/>',
		storm: '<path d="M6 14h11a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.5 2A3.5 3.5 0 0 0 6 14z"/><path d="M12 15l-2 4h4l-2 4"/>',
	};

	function describe(code: number, day: boolean): [string, string] {
		if (code === 0) return [day ? 'sun' : 'moon', 'clear'];
		if (code <= 2) return [day ? 'partly' : 'moon', 'partly cloudy'];
		if (code === 3) return ['cloud', 'overcast'];
		if (code <= 48) return ['fog', 'misty'];
		if (code <= 67 || (code >= 80 && code <= 82)) return ['rain', 'rain'];
		if (code >= 95) return ['storm', 'thunderstorms'];
		return ['cloud', 'cloudy'];
	}

	type Wx = { t: number; code: number; day: boolean; at: number };

	async function load(): Promise<Wx | null> {
		try {
			const cached = JSON.parse(sessionStorage.getItem(KEY) ?? 'null') as Wx | null;
			if (cached && Date.now() - cached.at < TTL) return cached;
		} catch {}
		try {
			const url = `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,weather_code,is_day&timezone=Asia%2FKolkata`;
			const res = await fetch(url);
			if (!res.ok) return null;
			const j = await res.json();
			const wx: Wx = { t: Math.round(j.current.temperature_2m), code: j.current.weather_code, day: j.current.is_day === 1, at: Date.now() };
			try {
				sessionStorage.setItem(KEY, JSON.stringify(wx));
			} catch {}
			return wx;
		} catch {
			return null;
		}
	}

	const clock = new Intl.DateTimeFormat('en-IN', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });

	async function init() {
		const root = document.querySelector<HTMLElement>('[data-wx]');
		if (!root || root.dataset.ready) return;
		root.dataset.ready = '1';
		const time = root.querySelector<HTMLElement>('[data-wx-time]')!;
		const tick = () => (time.textContent = `${clock.format(new Date()).toLowerCase()} IST`);
		tick();
		const id = setInterval(tick, 30_000);
		document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });

		const wx = await load();
		if (!wx) return;
		const [icon, label] = describe(wx.code, wx.day);
		// Let the toon in the hero dress for the weather.
		const detail = { ...wx, icon };
		(window as any).__wx = detail;
		document.dispatchEvent(new CustomEvent('wx:update', { detail }));
		root.querySelector('[data-wx-icon]')!.innerHTML = ICONS[icon];
		const temp = root.querySelector<HTMLElement>('[data-wx-temp]')!;
		temp.textContent = `${wx.t}°C, ${label}`;
		temp.hidden = false;
		root.querySelector<HTMLElement>('[data-wx-sep]')!.hidden = false;
		root.classList.add('live');
	}
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.wx {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.wx-icon {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.live .wx-icon {
		animation: wx-in 0.6s var(--ease-out);
	}
	@keyframes wx-in {
		from {
			opacity: 0;
			transform: scale(0.6) rotate(-30deg);
		}
	}
	.sep {
		color: var(--faint);
	}
</style>
