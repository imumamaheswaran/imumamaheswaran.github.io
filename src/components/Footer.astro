---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<p>© {year} {SITE_TITLE}</p>
		<ul>
			{
				SOCIAL_LINKS.map((l) => (
					<li>
						<a href={l.href} rel="me noopener" target="_blank">
							{l.label}
						</a>
					</li>
				))
			}
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 1.5rem 0 2.5rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.container {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	p {
		margin: 0;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
