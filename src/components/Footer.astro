---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="container wide inner">
		<p>
			© {year} {SITE_TITLE} · Drawn in Bengaluru
		</p>
		<ul>
			{
				SOCIAL_LINKS.map((l) => (
					<li>
						<a href={l.href} rel="me noopener" target="_blank">
							{l.label}
						</a>
					</li>
				))
			}
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	footer {
		padding: 1.5rem 0 2.5rem;
		border-top: 1px solid var(--rule);
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	/* A black belt runs along the top of the footer. */
	.belt {
		height: 0.9rem;
		background:
			repeating-linear-gradient(90deg, transparent 0 6px, rgb(255 255 255 / 0.05) 6px 7px),
			var(--belt);
		border-block: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
		margin-bottom: 1.75rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	p {
		margin: 0;
	}
	.kihap {
		color: var(--accent);
		font-weight: 700;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
