---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import Email from './Email.astro';
const year = new Date().getFullYear();

// Small line icons for the "Elsewhere" links, keyed by label.
const ICONS: Record<string, string> = {
	LinkedIn: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M11.5 17v-3.8a2.2 2.2 0 0 1 4.4 0V17M11.5 10.5V17"/>',
	X: '<path d="M4.5 4h4l11 16h-4zM19 4l-6.2 7M5 20l6.3-7.2"/>',
	RSS: '<path d="M5 19.5v.01M5 13a6.5 6.5 0 0 1 6.5 6.5M5 6.5A13 13 0 0 1 18 19.5"/>',
};
const elsewhere = [...SOCIAL_LINKS, { label: 'RSS', href: '/rss.xml' }];
---

<footer id="say-hello" aria-labelledby="say-hello-h">
	{/* The one place for contact details, on every page. */}
	<div class="container wide hello">
		<div>
			<p class="kicker bare" id="say-hello-h"><span class="n">●</span> Say hello</p>
			<p class="mail"><Email copy class="big" /></p>
		</div>
		<div class="else">
			<p class="kicker bare">Elsewhere</p>
			<ul class="elsewhere">
				{
					elsewhere.map((l) => (
						<li>
							<a
								href={l.href}
								{...(l.label === 'RSS' ? {} : { rel: 'me noopener', target: '_blank' })}
								aria-label={l.label === 'RSS' ? 'RSS feed' : `${l.label} (opens in a new tab)`}
								title={l.label}
							>
								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
									fill="none"
									stroke="currentColor"
									stroke-width="1.7"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={ICONS[l.label] ?? ''}
								/>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class="belt" aria-hidden="true"></div>
	<div class="container wide inner">
		<p>© {year} {SITE_TITLE} · Drawn in India · <span class="hint">Psst: type “kihap”</span></p>
		<p><a href="/bookshelf/">Bookshelf</a></p>
	</div>
</footer>

<style>
	footer {
		padding: 3.5rem 0 2.5rem;
		border-top: 1px solid var(--rule);
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	/* One row: say hello on the left, elsewhere on the right. */
	.hello {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 3rem;
		margin-bottom: 3rem;
		text-transform: none;
		letter-spacing: 0;
	}
	.hello .kicker {
		margin-bottom: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.mail {
		margin: 0;
	}
	.mail :global(.big a) {
		font-family: var(--font-sans);
		font-size: clamp(1.4rem, 4vw, 2.4rem);
		font-weight: 650;
		letter-spacing: -0.03em;
		color: var(--text);
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
	}
	.mail :global(.big a:hover) {
		color: var(--accent);
	}
	.else .kicker {
		justify-content: flex-end;
	}
	.elsewhere {
		gap: 0.6rem;
	}
	.elsewhere a {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border: 1px solid var(--rule);
		border-radius: 9px;
		color: var(--text);
		box-shadow: 0 3px 0 var(--rule);
		transition:
			transform 0.2s var(--ease-press),
			color 0.2s,
			border-color 0.2s;
	}
	.elsewhere a:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.elsewhere svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	@media (max-width: 640px) {
		.else .kicker {
			justify-content: flex-start;
		}
	}
	/* A black belt runs between the hello and the small print. */
	.belt {
		position: relative;
		overflow: hidden;
		height: 0.9rem;
		background:
			repeating-linear-gradient(90deg, transparent 0 6px, rgb(255 255 255 / 0.05) 6px 7px),
			var(--belt);
		border-block: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
		margin-bottom: 1.75rem;
	}
	/* Now and then, a gold sheen slides along the belt. */
	@media (prefers-reduced-motion: no-preference) {
		.belt::after {
			content: '';
			position: absolute;
			inset: 0;
			width: 18%;
			background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--gold) 45%, transparent), transparent);
			transform: translateX(-120%);
			animation: sheen 7s ease-in-out infinite;
		}
	}
	@keyframes sheen {
		0%,
		60% {
			transform: translateX(-120%);
		}
		100% {
			transform: translateX(650%);
		}
	}
	.hint {
		color: var(--faint);
		opacity: 0.8;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	p {
		margin: 0;
	}
	.kihap {
		color: var(--accent);
		font-weight: 700;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--text);
	}
</style>
