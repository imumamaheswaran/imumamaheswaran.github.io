---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/#architecture', label: 'Architecture' },
	{ href: '/blog/', label: 'Writing' },
	{ href: '/about-me/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header>
	<nav class="container wide" aria-label="Main">
		<a class="brand" href="/">
			<img class="mark" src="/favicon.svg" width="36" height="36" alt="" />
			<span class="brand-name" data-board
				><span class="half left">{SITE_TITLE.slice(0, Math.ceil(SITE_TITLE.length / 2))}</span><span class="half right"
					>{SITE_TITLE.slice(Math.ceil(SITE_TITLE.length / 2))}</span
				><span class="dot">.</span><span class="splinters" aria-hidden="true"
					><i></i><i></i><i></i><i></i><i></i></span
				></span
			>
		</a>
		<div class="links">
			{
				links.map((l) => (
					<a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
						<span>{l.label}</span>
					</a>
				))
			}
			<button type="button" class="theme-toggle sound-toggle" aria-label="Sound effects" aria-pressed="true">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M11 5 6 9H3v6h3l5 4z"></path>
					<path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
					<path class="mute" d="m16 9 6 6m0-6-6 6"></path>
				</svg>
			</button>
			<button type="button" class="theme-toggle" aria-label="Dark mode" aria-pressed="false">
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path
						d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	</nav>
	<!-- Reading progress, tied as a belt that earns its colours as you scroll. -->
	<div class="progress" aria-hidden="true"></div>
</header>

<script>
	import { setSound, soundOn, tick } from '../lib/sound';

	function init() {
		const root = document.documentElement;
		const theme = document.querySelector<HTMLButtonElement>('.theme-toggle:not(.sound-toggle)');
		const sound = document.querySelector<HTMLButtonElement>('.sound-toggle');
		const isDark = () =>
			root.dataset.theme
				? root.dataset.theme === 'dark'
				: window.matchMedia('(prefers-color-scheme: dark)').matches;
		theme?.setAttribute('aria-pressed', String(isDark()));
		theme?.addEventListener('click', () => {
			const next = isDark() ? 'light' : 'dark';
			const swap = () => {
				root.dataset.theme = next;
				theme.setAttribute('aria-pressed', String(next === 'dark'));
			};
			// Sweep the new theme in from the toggle, where supported.
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (document.startViewTransition && !reduced) {
				const r = theme.getBoundingClientRect();
				root.style.setProperty('--tx', `${r.left + r.width / 2}px`);
				root.style.setProperty('--ty', `${r.top + r.height / 2}px`);
				root.classList.add('theme-swap');
				document.startViewTransition(swap).finished.finally(() => root.classList.remove('theme-swap'));
			} else swap();
			tick();
			try {
				localStorage.setItem('theme', next);
			} catch {}
		});
		sound?.setAttribute('aria-pressed', String(soundOn()));
		sound?.addEventListener('click', () => {
			const on = !soundOn();
			setSound(on);
			sound.setAttribute('aria-pressed', String(on));
			tick();
		});
	}
	document.addEventListener('astro:page-load', init);

	// 격파: the full stop chops the name like a board. It cracks into a V,
	// splinters fly, and it snaps back together. Plays once per visit on
	// arrival, then on hover. Skipped entirely for reduced motion.
	function boardBreak() {
		const name = document.querySelector<HTMLElement>('[data-board]');
		if (!name || name.dataset.wired !== undefined) return;
		name.dataset.wired = '';
		const reduced = matchMedia('(prefers-reduced-motion: reduce)');
		const left = name.querySelector<HTMLElement>('.half.left')!;
		const right = name.querySelector<HTMLElement>('.half.right')!;
		const dot = name.querySelector<HTMLElement>('.dot')!;
		const bits = [...name.querySelectorAll<HTMLElement>('.splinters i')];
		let busy = false;

		const strike = () => {
			if (busy || reduced.matches || !name.offsetParent) return;
			busy = true;
			const seam = right.getBoundingClientRect().left;
			name.style.setProperty('--seam', `${right.offsetLeft}px`);
			const d = dot.getBoundingClientRect();
			const dx = seam - (d.left + d.width / 2);
			const T = 950;
			const hit = 0.32;
			const ease = 'cubic-bezier(0.2, 0.9, 0.3, 1.2)';

			// Wind up above the seam, chop down, then hop home.
			dot.animate(
				[
					{ transform: 'translate(0, 0)' },
					{ transform: `translate(${dx * 0.6}px, -16px) scale(1.4)`, offset: 0.2 },
					{ transform: `translate(${dx}px, -12px) scale(1.5)`, offset: 0.27 },
					{ transform: `translate(${dx}px, 2px) scale(1.2)`, offset: hit, easing: 'ease-out' },
					{ transform: `translate(${dx}px, -4px) scale(1.2)`, offset: 0.55 },
					{ transform: 'translate(0, 0)' },
				],
				{ duration: T, easing: 'ease-in-out' },
			);
			// Each half pivots on its outer end, so the middle drops: a V.
			const crack = (el: HTMLElement, deg: number) =>
				el.animate(
					[
						{ transform: 'none', offset: 0 },
						{ transform: 'none', offset: hit },
						{ transform: `translateY(3px) rotate(${deg}deg)`, offset: hit + 0.06 },
						{ transform: `translateY(2px) rotate(${deg * 0.8}deg)`, offset: 0.62 },
						{ transform: 'none', offset: 0.85, easing: ease },
						{ transform: 'none' },
					],
					{ duration: T },
				);
			crack(left, 7);
			const last = crack(right, -7);
			// Splinters burst from the seam at the moment of impact.
			bits.forEach((b, i) => {
				const a = (-150 + i * 30 + Math.random() * 16) * (Math.PI / 180);
				const r = 14 + Math.random() * 10;
				b.animate(
					[
						{ opacity: 0, transform: 'translate(0, 0) rotate(0deg)' },
						{ opacity: 1, transform: 'translate(0, 0) rotate(0deg)', offset: 0.01 },
						{
							opacity: 0,
							transform: `translate(${Math.cos(a) * r}px, ${Math.sin(a) * r + 10}px) rotate(${i * 70}deg)`,
						},
					],
					{ duration: T * 0.5, delay: T * hit, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)', fill: 'backwards' },
				);
			});
			last.finished.finally(() => setTimeout(() => (busy = false), 600));
		};

		name.closest('.brand')?.addEventListener('pointerenter', (e) => {
			if ((e as PointerEvent).pointerType === 'mouse') strike();
		});
		let seen = false;
		try {
			seen = sessionStorage.getItem('board-broken') === '1';
			sessionStorage.setItem('board-broken', '1');
		} catch {}
		if (!seen) setTimeout(strike, 700);
	}
	document.addEventListener('astro:page-load', boardBreak);
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.25rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		color: var(--text);
		text-decoration: none;
		font-size: 1.05rem;
	}
	.mark {
		border-radius: 50%;
		transition: transform 0.5s var(--ease-press);
	}
	/* A small bow on hover. */
	.brand:hover .mark {
		transform: rotate(-12deg) translateY(2px);
	}
	.dot {
		color: var(--accent);
	}
	.brand-name {
		position: relative;
		white-space: nowrap;
	}
	.half,
	.dot {
		display: inline-block;
	}
	.half.left {
		transform-origin: 0% 100%;
	}
	.half.right {
		transform-origin: 100% 100%;
	}
	.splinters {
		position: absolute;
		left: var(--seam, 50%);
		top: 55%;
		pointer-events: none;
	}
	.splinters i {
		position: absolute;
		width: 5px;
		height: 2px;
		border-radius: 1px;
		background: var(--wood);
		opacity: 0;
	}
	.splinters i:nth-child(odd) {
		background: var(--wood-dark);
		width: 3px;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.links .theme-toggle + .theme-toggle {
		margin-left: -0.9rem;
	}
	.links a {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		color: var(--muted);
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.links a .ko {
		font-size: 0.8rem;
		color: var(--accent);
		opacity: 0.8;
	}
	.links a:hover,
	.links a[aria-current='page'] {
		color: var(--text);
	}
	.links a[aria-current='page'] span:first-child {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.4em;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--text);
	}
	.sound-toggle .mute {
		display: none;
	}
	.sound-toggle[aria-pressed='false'] .mute {
		display: block;
	}
	.sound-toggle[aria-pressed='false'] .wave {
		display: none;
	}
	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 3px;
		transform-origin: left;
		transform: scaleX(0);
		background: var(--accent);
	}
	@supports (animation-timeline: scroll()) {
		.progress {
			animation: belt-progress linear both;
			animation-timeline: scroll(root);
		}
	}
	@keyframes belt-progress {
		0% {
			transform: scaleX(0);
			background: #d9dce1;
		}
		20% {
			background: #e2b419;
		}
		40% {
			background: #2f7a3b;
		}
		60% {
			background: #0047a0;
		}
		80% {
			background: #cd2e3a;
		}
		100% {
			transform: scaleX(1);
			background: #0d0e10;
			box-shadow: 0 0 0 1px #d8b45e;
		}
	}
	.moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .moon {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: block;
		}
	}
	@media (max-width: 480px) {
		.brand-name {
			display: none;
		}
	}
	@media (max-width: 640px) {
		.links {
			gap: 1rem;
		}
		.links a[href='/#architecture'] {
			display: none;
		}
	}
</style>
