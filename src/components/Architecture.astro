<script>
	import { tick } from '../lib/sound';

	function init() {
		const root = document.querySelector<HTMLElement>('[data-arch]');
		if (!root || root.dataset.ready) return;
		root.dataset.ready = '1';
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		const stages = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
		let current = 0;

		function select(i: number, focus = false) {
			i = (i + tabs.length) % tabs.length;
			tabs.forEach((t, k) => {
				t.setAttribute('aria-selected', String(k === i));
				t.tabIndex = k === i ? 0 : -1;
			});
			stages.forEach((s, k) => {
				s.hidden = k !== i;
				s.classList.remove('enter');
			});
			void stages[i].offsetWidth;
			stages[i].classList.add('enter');
			if (focus) tabs[i].focus();
			if (i !== current) tick();
			current = i;
		}

		tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
		root.querySelector('[role=tablist]')!.addEventListener('keydown', (e) => {
			const k = (e as KeyboardEvent).key;
			const map: Record<string, number> = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 };
			if (k in map) {
				e.preventDefault();
				select(map[k], true);
			}
		});
		stages[0].classList.add('enter');
	}
	document.addEventListener('astro:page-load', init);
</script>

