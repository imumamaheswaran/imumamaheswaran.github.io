---
/**
 * How I work, at five altitudes: business, product, system, code and team.
 * Each altitude has its own small drawing, the principle behind it, real
 * examples from my work, and the books that shaped it.
 */

type Stage = {
	id: string;
	tab: string;
	label: string;
	title: string;
	body: string;
	practice: string[];
	books: string[];
};

const stages: Stage[] = [
	{
		id: 'business',
		tab: 'Business',
		label: 'Business & domain',
		title: 'Learn the business before drawing a box.',
		body: "I start with the domain's own language: how money, approvals and data really move. The architecture should read like the business, not like the framework.",
		practice: [
			'Pricing and quoting (CPQ) at Provus',
			'Revenue and incentive management at Conga',
			'Healthcare provider data at Definitive Healthcare',
			'Labour-market analytics at Lightcast',
		],
		books: [],
	},
	{
		id: 'product',
		tab: 'Product',
		label: 'Product',
		title: 'Build what people come back to.',
		body: 'Architecture exists to serve a product people use. I think in user journeys and habit loops, and keep change cheap wherever the product is still learning.',
		practice: ['Faster physician search and reporting at Definitive Healthcare', 'Building AI-powered products at Provus'],
		books: ['Hooked', 'The Design of Everyday Things', "AI Product Manager's Handbook"],
	},
	{
		id: 'system',
		tab: 'System',
		label: 'System',
		title: 'Boundaries first, then boxes.',
		body: 'Services drawn around business capabilities, each owning its data, with events in between. Cost and latency are design inputs, not afterthoughts.',
		practice: [
			'Architected and built CPQ Express',
			'Moved critical services to AWS, cutting costs by 40%',
			'Data platform with 95% of queries under 200 ms',
		],
		books: ['Operating Systems: Three Easy Pieces'],
	},
	{
		id: 'code',
		tab: 'Code',
		label: 'Code',
		title: 'Code that stays cheap to change.',
		body: 'SOLID, clear seams and dependencies that point inward. The domain stays free of frameworks, so it can outlive them.',
		practice: ['Reusable components and engineering practices at Conga', 'Writing on when libraries like MediatR stop earning their place'],
		books: ['Adaptive Code via C#', 'C# in Depth'],
	},
	{
		id: 'team',
		tab: 'Team',
		label: 'Team',
		title: 'Standards that scale past me.',
		body: "Design reviews, kind code reviews and CI that catches what people shouldn't have to. My job is to make the next engineer faster.",
		practice: [
			'Led a team of 5 at Kovai.co',
			'Ran design reviews for the scrum team at Conga',
			'Engineering standards and CI-ready workflows at Provus',
		],
		books: ['Looks Good to Me'],
	},
];

// Points on a circle, for the product loop.
const pt = (a: number, r = 120, cx = 280, cy = 150) => {
	const rad = (a * Math.PI) / 180;
	return `${(cx + r * Math.cos(rad)).toFixed(1)} ${(cy + r * Math.sin(rad)).toFixed(1)}`;
};
const arcs = [
	[-70, -20],
	[20, 70],
	[110, 160],
	[200, 250],
].map(([a, b]) => `M${pt(a)} A120 120 0 0 1 ${pt(b)}`);
---

<section id="architecture" class="arch" aria-labelledby="arch-heading" data-arch data-reveal>
	<p class="kicker"><span class="n">01</span> How I work</p>
	<h2 id="arch-heading">Architecture isn't one diagram.</h2>
	<p class="intro">It's five altitudes, from the business problem down to the code. I work at all of them.</p>

	<div class="tabs" role="tablist" aria-label="Altitudes">
		{
			stages.map((s, i) => (
				<button
					type="button"
					role="tab"
					id={`alt-tab-${s.id}`}
					aria-controls={`alt-${s.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-tab={i}
				>
					<span class="num">{String(i + 1).padStart(2, '0')}</span>
