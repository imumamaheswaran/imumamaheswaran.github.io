---
/**
 * How I architect, drawn straight onto the page's grid paper. Each layer of a
 * system maps to a stance; click a layer to read the principle behind it.
 */

type Node = {
	id: string;
	label: string;
	sub: string;
	x: number;
	y: number;
	w: number;
	h: number;
	stance: string;
	title: string;
	body: string;
	tech: string[];
};

const nodes: Node[] = [
	{
		id: 'client',
		label: 'Clients',
		sub: 'React · Next.js',
		x: 16, y: 176, w: 128, h: 56,
		stance: 'Front stance',
		title: 'Lean toward the user.',
		body: 'The front end carries its weight forward: typed end to end, fast on first paint, and honest about loading and failure states.',
		tech: ['React', 'Next.js', 'TypeScript'],
	},
	{
		id: 'gateway',
		label: 'API gateway',
		sub: 'auth · limits',
		x: 188, y: 176, w: 128, h: 56,
		stance: 'Closed stance',
		title: 'One narrow, guarded entrance.',
		body: 'A single front door for identity, rate limits and versioning, so the services behind it can stay simple and change safely.',
		tech: ['OAuth / OIDC', 'Versioning', 'Rate limits'],
	},
	{
		id: 'services',
		label: 'Domain services',
		sub: '.NET microservices',
		x: 362, y: 158, w: 140, h: 92,
		stance: 'Horse-riding stance',
		title: 'A wide, stable base.',
		body: 'Services drawn around business boundaries, each owning its own data. Clear contracts first, so teams can move without stepping on each other.',
		tech: ['.NET / C#', 'Microservices', 'DDD'],
	},
	{
		id: 'bus',
		label: 'Event bus',
		sub: 'async · retries',
		x: 548, y: 120, w: 128, h: 56,
		stance: 'Tiger stance',
		title: 'Weight back, ready to react.',
		body: 'Events decouple who does the work from who asked for it. Consumers are idempotent, retries are expected, and nothing is lost when one part falls over.',
		tech: ['Queues', 'Logic Apps', 'Idempotency'],
	},
	{
		id: 'data',
		label: 'Data',
		sub: 'PostgreSQL · Redis',
		x: 548, y: 236, w: 128, h: 56,
		stance: 'Parallel stance',
		title: 'Balanced on both feet.',
		body: 'A relational store for the source of truth and a fast store for what has to be instant. Pick each one for the access pattern, not out of habit.',
		tech: ['PostgreSQL', 'Redis', 'Blob storage'],
	},
	{
		id: 'ai',
		label: 'AI layer',
		sub: 'LLMs · agents',
		x: 362, y: 22, w: 140, h: 56,
		stance: 'Back stance',
		title: 'Guarded, with room to move.',
		body: 'The model is a component, not the architecture. It sits behind guardrails, evaluations and fallbacks, so the product still works when the model is wrong.',
		tech: ['LLMs', 'Agents', 'Evals'],
	},
];

// Edges as paths between node edges (drawn and animated in the SVG).
const edges = [
	{ id: 'e1', d: 'M144 204 H188' },
	{ id: 'e2', d: 'M316 204 H362' },
	{ id: 'e3', d: 'M432 158 V78' },
	{ id: 'e4', d: 'M502 186 C525 186 525 148 548 148' },
	{ id: 'e5', d: 'M502 224 C525 224 525 264 548 264' },
	{ id: 'e6', d: 'M612 176 V236' },
];
---

<section id="architecture" class="arch" aria-labelledby="arch-heading" data-arch data-reveal>
	<p class="kicker"><span class="n">01</span> Architecture</p>
	<h2 id="arch-heading">Every system starts from a stance.</h2>
	<p class="intro">The shape I reach for most often. Pick a layer to see why.</p>

	<div class="layout">
		<svg viewBox="0 0 692 312" role="group" aria-label="Architecture diagram">
			<rect class="cloud" x="172" y="104" width="512" height="200"></rect>
			<text class="anno" x="180" y="98">Azure / AWS</text>
			{edges.map((e) => <path id={`arch-${e.id}`} class="edge" d={e.d} pathLength="1" />)}
			{
				edges.map((e, i) => (
					<circle class="packet" r="2.5">
						<animateMotion dur={`${2.4 + (i % 3) * 0.5}s`} repeatCount="indefinite" begin={`${i * 0.35}s`}>
							<mpath href={`#arch-${e.id}`} />
						</animateMotion>
					</circle>
				))
			}
			{
				nodes.map((n, i) => (
					<g
						class="node"
						data-node={n.id}
						role="button"
						tabindex="0"
						aria-pressed={i === 2 ? 'true' : 'false'}
						aria-label={`${n.label}: ${n.stance}`}
						style={`--i:${i}`}
					>
						<text class="nid" x={n.x} y={n.y - 6}>
							{String(i + 1).padStart(2, '0')}
						</text>
						<rect x={n.x} y={n.y} width={n.w} height={n.h} />
						<text class="nl" x={n.x + n.w / 2} y={n.y + n.h / 2 - 2}>
							{n.label}
						</text>
						<text class="ns" x={n.x + n.w / 2} y={n.y + n.h / 2 + 14}>
							{n.sub}
						</text>
					</g>
				))
			}
		</svg>

		<div class="panel" aria-live="polite">
			{
				nodes.map((n, i) => (
					<article class="principle" data-principle={n.id} hidden={i !== 2}>
						<p class="stance">
							{String(i + 1).padStart(2, '0')} / {n.stance}
						</p>
						<h3>{n.title}</h3>
						<p class="body">{n.body}</p>
						<ul class="tech" aria-label="Tools">
							{n.tech.map((t) => (
								<li>{t}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	import { tick } from '../lib/sound';

	function init() {
		const root = document.querySelector<HTMLElement>('[data-arch]');
		if (!root || root.dataset.ready) return;
		root.dataset.ready = '1';
		const nodes = [...root.querySelectorAll<SVGGElement>('[data-node]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-principle]')];

		function show(id: string, sound = true) {
			nodes.forEach((n) => n.setAttribute('aria-pressed', String(n.dataset.node === id)));
			panels.forEach((p) => {
				const on = p.dataset.principle === id;
				p.hidden = !on;
				p.classList.toggle('enter', on);
			});
			if (sound) tick();
		}

		nodes.forEach((n) => {
			n.addEventListener('click', () => show(n.dataset.node!));
			n.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					show(n.dataset.node!);
				}
			});
		});
		show('services', false);
	}
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.arch {
		margin: 4rem 0 7rem;
		scroll-margin-top: 5.5rem;
	}
	h2 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.9rem, 4.5vw, 3rem);
	}
	.intro {
		margin: 0 0 3rem;
		color: var(--muted);
		font-size: 1.1rem;
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.cloud {
		fill: none;
		stroke: var(--blue);
		stroke-width: 1;
		stroke-dasharray: 4 4;
		opacity: 0.55;
	}
	.anno,
	.nid {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		fill: var(--blue);
	}
	.nid {
		fill: var(--faint);
	}
	.edge {
		fill: none;
		stroke: var(--blue);
		stroke-width: 1.2;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		opacity: 0.75;
	}
	:global(.in) .edge {
		animation: draw 1.1s var(--ease-out) 0.5s forwards;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	.packet {
		fill: var(--accent);
		opacity: 0;
	}
	:global(.in) .packet {
		animation: show 0.3s 1.5s forwards;
	}
	@keyframes show {
		to {
			opacity: 1;
		}
	}
	.node {
		cursor: pointer;
		outline: none;
	}
	.node rect {
		fill: var(--bg);
		stroke: var(--text);
		stroke-width: 1;
		transition:
			fill 0.25s,
			stroke 0.25s;
	}
	:global(.in) .node {
		animation: node-in 0.6s var(--ease-out) backwards;
		animation-delay: calc(var(--i) * 80ms + 150ms);
	}
	@keyframes node-in {
		from {
			opacity: 0;
		}
	}
	.node text {
		pointer-events: none;
	}
	.nl,
	.ns {
		text-anchor: middle;
	}
	.nl {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: -0.01em;
		fill: var(--text);
	}
	.ns {
		font-family: var(--font-mono);
		font-size: 10px;
		fill: var(--muted);
	}
	.node:hover rect {
		stroke: var(--accent);
	}
	.node:focus-visible rect {
		stroke: var(--accent);
		stroke-width: 2.5;
	}
	.node[aria-pressed='true'] rect {
		fill: var(--accent);
		stroke: var(--accent);
	}
	.node[aria-pressed='true'] .nl,
	.node[aria-pressed='true'] .ns {
		fill: #fff;
	}
	.node[aria-pressed='true'] .nid {
		fill: var(--accent);
	}

	/* The principle sits beside the drawing, marked off by a single rule. */
	.panel {
		padding-left: clamp(1.25rem, 3vw, 2rem);
		border-left: 1px solid var(--rule);
		min-height: 15rem;
	}
	.principle.enter {
		animation: slide 0.45s var(--ease-out);
	}
	@keyframes slide {
		from {
			opacity: 0;
			transform: translateX(10px);
		}
	}
	.stance {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.principle h3 {
		margin: 0 0 0.6rem;
		font-size: 1.5rem;
	}
	.body {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.65;
	}
	.tech {
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text);
	}
	.tech li::before {
		content: '> ';
		color: var(--faint);
	}

	@media (max-width: 860px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.panel {
			padding-left: 1rem;
			min-height: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.packet {
			display: none;
		}
		.edge {
			stroke-dashoffset: 0;
		}
	}
</style>
