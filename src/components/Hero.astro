---
/** Home page hero, drawn like the title sheet of a blueprint. */
import avatarSvg from '../assets/avatar.svg?raw';
---

<section class="hero" aria-labelledby="hero-name">
	<div class="text">
		<p class="kicker bare in-1"><span class="n">●</span> Software Architect // Bengaluru</p>
		<h1 id="hero-name" aria-label="Umamaheswaran">
			<span aria-hidden="true">
				{[...'Umamaheswaran'].map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}<span
					class="ch dot"
					style="--i:13">.</span
				>
			</span>
		</h1>
		<div class="dim" aria-hidden="true">
			<span class="dim-line"></span>
			<span class="dim-label">15+ years · .NET · React · cloud</span>
			<span class="dim-line"></span>
		</div>
		<p class="title in-2">Software Architect <span>/ Engineering Manager</span></p>
		<p class="lede in-2">I design platforms that teams can build on, and lately the AI products that sit on top of them.</p>
		<div class="actions in-3">
			<a class="btn primary" href="#architecture">How I architect</a>
			<a class="btn" href="/blog/">Read my writing</a>
		</div>
	</div>

	<figure class="figure in-3">
		<button type="button" class="toon" data-toon aria-label="Say hello to toon Uma">
			<span class="toon-body" set:html={avatarSvg} />
			<span class="bubble" data-bubble aria-live="polite"></span>
		</button>
		<span class="callout c1" aria-hidden="true"><span>Black belt</span></span>
		<span class="callout c2" aria-hidden="true"><span>Architect</span></span>
		<figcaption class="mono">Fig. 1 — The architect, off duty</figcaption>
	</figure>
</section>

<script>
	import { whoosh } from '../lib/sound';

	const LINES = ['Hello!', 'Taekwondo!', 'Stance first.', 'Ship it small.', 'Draw the boxes first.'];
	function init() {
		const toon = document.querySelector<HTMLButtonElement>('[data-toon]');
		if (!toon || toon.dataset.ready) return;
		toon.dataset.ready = '1';
		const bubble = toon.querySelector<HTMLElement>('[data-bubble]')!;
		let n = 0;
		let timer = 0;
		toon.addEventListener('click', () => {
			bubble.textContent = LINES[n++ % LINES.length];
			toon.classList.remove('pop');
			void toon.offsetWidth;
			toon.classList.add('pop');
			whoosh();
			clearTimeout(timer);
			timer = window.setTimeout(() => toon.classList.remove('pop'), 1800);
		});
	}
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		min-height: min(78vh, 46rem);
		padding: 2rem 0 4rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.3rem, 5.6vw, 4.4rem);
		font-weight: 700;
		letter-spacing: -0.055em;
		line-height: 0.95;
		white-space: nowrap;
	}
	.dot {
		color: var(--accent);
	}
	.ch {
		display: inline-block;
		animation: rise 0.8s var(--ease-out) both;
		animation-delay: calc(var(--i) * 28ms + 80ms);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.45em);
		}
	}

	/* A drafting dimension line under the name. */
	.dim {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 1.1rem 0 1.75rem;
		max-width: 34rem;
		color: var(--blue);
		animation: fade 0.6s var(--ease-out) 0.6s both;
	}
	.dim-line {
		position: relative;
		flex: 1;
		height: 1px;
		background: currentColor;
		opacity: 0.6;
		transform-origin: center;
		animation: grow 0.8s var(--ease-out) 0.7s both;
	}
	.dim-line:first-child::before,
	.dim-line:last-child::after {
		content: '';
		position: absolute;
		top: -5px;
		width: 1px;
		height: 11px;
		background: currentColor;
	}
	.dim-line:first-child::before {
		left: 0;
	}
	.dim-line:last-child::after {
		right: 0;
	}
	.dim-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	@keyframes grow {
		from {
			transform: scaleX(0);
		}
	}
	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	.title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.25rem, 2.6vw, 1.6rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.title span {
		color: var(--muted);
		font-weight: 400;
	}
	.lede {
		max-width: 32rem;
		margin: 0 0 2rem;
		color: var(--muted);
		font-size: 1.1rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 1.2rem;
		border: 1px solid var(--text);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background 0.2s,
			color 0.2s;
	}
	.btn:hover {
		background: var(--text);
		color: var(--bg);
	}
	.btn.primary {
		background: var(--text);
		color: var(--bg);
	}
	.btn.primary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.in-1,
	.in-2,
	.in-3 {
		animation: fade-up 0.8s var(--ease-out) both;
	}
	.in-2 {
		animation-delay: 0.45s;
	}
	.in-3 {
		animation-delay: 0.65s;
	}
	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	/* Fig. 1: the toon, with drafting callouts. */
	.figure {
		position: relative;
		margin: 0;
		justify-self: center;
		width: min(100%, 20rem);
	}
	.toon {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}
	.toon-body {
		display: block;
		transform-origin: 50% 100%;
		animation: breathe 4s ease-in-out infinite;
	}
	.toon-body :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
	.toon-body :global(.eyes) {
		transform-box: fill-box;
		transform-origin: center;
		animation: blink 5s infinite;
	}
	@keyframes breathe {
		50% {
			transform: scaleY(1.012) translateY(-1px);
		}
	}
	@keyframes blink {
		0%,
		92%,
		100% {
			transform: scaleY(1);
		}
		95% {
			transform: scaleY(0.1);
		}
	}
	.toon:hover .toon-body {
		animation: bow 0.9s var(--ease-out);
	}
	@keyframes bow {
		40% {
			transform: rotate(-4deg) translateY(4px);
		}
	}
	.toon.pop .toon-body {
		animation: hop 0.5s var(--ease-press);
	}
	@keyframes hop {
		40% {
			transform: translateY(-14px) scale(1.02, 0.98);
		}
	}
	.toon:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	.bubble {
		position: absolute;
		top: 2%;
		left: -8%;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--text);
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.2s,
			transform 0.35s var(--ease-press);
		pointer-events: none;
	}
	.pop .bubble {
		opacity: 1;
		transform: none;
	}
	.callout {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--blue);
		white-space: nowrap;
		pointer-events: none;
	}
	.callout::before {
		content: '';
		width: 2rem;
		height: 1px;
		background: currentColor;
		opacity: 0.7;
	}
	.callout::after {
		content: '';
		position: absolute;
		left: -3px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}
	.c1 {
		left: 90%;
		bottom: 15%;
	}
	.c2 {
		left: 66%;
		top: 30%;
	}
	figcaption {
		margin-top: 0.75rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--rule);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
		text-align: center;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: 0;
			padding-top: 0.5rem;
		}
		.figure {
			width: min(80%, 16rem);
		}
		.callout {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.toon-body,
		.toon-body :global(.eyes) {
			animation: none;
		}
	}
</style>
