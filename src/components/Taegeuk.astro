---
/** The red-and-blue taegeuk mark used as the site logo and section marker. */
interface Props {
	size?: number;
	class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="-10.5 -10.5 21 21" aria-hidden="true">
	<g transform="rotate(-33.7)">
		<circle r="10" fill="var(--blue)"></circle>
		<path d="M-10 0A10 10 0 0 1 10 0A5 5 0 0 1 0 0A5 5 0 0 0 -10 0Z" fill="var(--accent)"></path>
	</g>
</svg>
