---
// Email signup via Buttondown, dressed as a belt test: the belt ranks up as
// the email address takes shape, and turns black once it's valid. Buttondown
// handles confirmation (double opt-in) and unsubscribes.
const USERNAME = 'umamaheswaran';
interface Props {
	class?: string;
	/**
	 * "row" is a card; "line" is one slim, borderless line under a list or a
	 * note; "stack" is one narrow column.
	 */
	layout?: 'row' | 'line' | 'stack';
}
const { layout = 'row' } = Astro.props;
const id = `bd-email-${Math.random().toString(36).slice(2, 8)}`;
---

<form
	class:list={['subscribe', { stack: layout === 'stack', line: layout === 'line' }, Astro.props.class]}
	action={`https://buttondown.com/api/emails/embed-subscribe/${USERNAME}`}
	method="post"
	target="_blank"
	data-subscribe
	data-rank="none"
>
	{/* One row: the belt and a line on the left, the email and button on the right. */}
	<div class="head">
		<svg class="belt" viewBox="0 0 64 28" aria-hidden="true">
			<rect class="band" x="2" y="7" width="60" height="9" rx="1.5"></rect>
			<rect class="band knot" x="26" y="5" width="12" height="13" rx="2"></rect>
			<path class="band tail" d="M29 17 L23 27 L28 27 L32 19 Z"></path>
			<path class="band tail" d="M35 17 L41 27 L36 27 L32 19 Z"></path>
		</svg>
		<div>
			<label for={id}>Join the dojang.</label>
			<p class="hint">New notes by email. No spam; leave anytime.</p>
		</div>
	</div>
	<div class="row">
		<input id={id} type="email" name="email" placeholder="your@email.com" autocomplete="email" required />
		<input type="hidden" name="embed" value="1" />
		<button type="submit">Bow in</button>
	</div>
	<p class="rank" aria-hidden="true" data-rank-label></p>
	<p class="done" role="status" data-done></p>
</form>

<script>
	import { thwack } from '../lib/sound';

	// Taekwondo belt order, earned one step of a valid email at a time.
	const RANKS: [string, (v: string, valid: boolean) => boolean, string][] = [
		// Browsers accept "name@host" as valid, so black also needs a real ending like ".com".
		['black', (v, ok) => ok && /@[^@\s]+\.[^@\s.]{2,}$/.test(v), 'Black belt. Ready to bow in.'],
		['red', (v) => /@[^@\s]+\.[^@\s]*$/.test(v), 'Red belt. One more technique.'],
		['blue', (v) => /@[^@\s]+$/.test(v), 'Blue belt. Now the dot.'],
		['green', (v) => v.includes('@'), 'Green belt. Where do you train?'],
		['yellow', (v) => v.length > 0, 'Yellow belt. Keep going.'],
		['none', () => true, ''],
	];

	function init() {
		document.querySelectorAll<HTMLFormElement>('form[data-subscribe]:not([data-ready])').forEach((form) => {
			form.dataset.ready = '';
			const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
			const label = form.querySelector<HTMLElement>('[data-rank-label]')!;
			const done = form.querySelector<HTMLElement>('[data-done]')!;

			input.addEventListener('input', () => {
				const v = input.value.trim();
				const [rank, , text] = RANKS.find(([, test]) => test(v, input.validity.valid && v.length > 0))!;
				if (form.dataset.rank !== rank) {
					form.dataset.rank = rank;
					label.textContent = text;
				}
			});

			form.addEventListener('submit', () => {
				thwack();
				form.dataset.sent = '';
				done.textContent = 'Kihap! Check your inbox and confirm to finish your belt test.';
			});
		});
	}

	document.addEventListener('astro:page-load', init);
</script>

<style>
	.subscribe {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		align-items: center;
		gap: 0.5rem 1.5rem;
		margin-top: 3rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		--belt-color: transparent;
		--belt-line: var(--rule);
	}
	.subscribe[data-rank='yellow'] {
		--belt-color: #f2c230;
	}
	.subscribe[data-rank='green'] {
		--belt-color: #2f9e55;
	}
	.subscribe[data-rank='blue'] {
		--belt-color: #1f5fbf;
	}
	.subscribe[data-rank='red'] {
		--belt-color: #cd2e3a;
	}
	.subscribe[data-rank='black'] {
		--belt-color: var(--belt);
		--belt-line: var(--gold);
	}

	.head {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	.belt {
		flex: none;
		width: 2.75rem;
	}
	.band {
		fill: var(--belt-color);
		stroke: var(--belt-line);
		stroke-width: 1.5;
		transition:
			fill 0.25s ease,
			stroke 0.25s ease;
	}
	.subscribe[data-rank='black'] .belt {
		animation: tie 0.45s var(--ease-press);
	}
	@keyframes tie {
		40% {
			transform: rotate(-6deg) scale(1.08);
		}
	}

	label {
		display: block;
		font-weight: 600;
		font-size: 1rem;
	}
	.hint,
	.rank {
		color: var(--muted);
		font-size: 0.82rem;
		margin: 0.1rem 0 0;
	}
	.row {
		display: flex;
		gap: 0.5rem;
	}
	input[type='email'] {
		flex: 1 1 10rem;
		min-width: 0;
		font: inherit;
		font-size: 1rem;
		padding: 0.45rem 0.7rem;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: 6px;
	}
	input[type='email']:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	button {
		font: inherit;
		font-weight: 600;
		padding: 0.45rem 1rem;
		color: var(--bg);
		background: var(--accent);
		border: 0;
		border-radius: 6px;
		cursor: pointer;
		transition: transform 0.15s var(--ease-press);
	}
	button:active {
		transform: scale(0.95) rotate(-1deg);
	}
	button:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}
	/* The belt rank shows only once someone starts typing. */
	.rank {
		grid-column: 2;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		margin: 0;
	}
	.rank:empty,
	.done:empty {
		display: none;
	}
	.done {
		grid-column: 1 / -1;
		margin: 0;
		font-weight: 600;
		color: var(--accent);
	}
	.subscribe[data-sent] .rank {
		display: none;
	}
	/* Line: no card, just a dashed rule above and everything on one line. */
	.subscribe.line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.25rem;
		margin-top: 1.5rem;
		padding: 1rem 0 0;
		border: 0;
		border-top: 1px dashed var(--rule);
		border-radius: 0;
		background: none;
	}
	.line .head {
		flex: 0 1 auto;
	}
	.line .head > div {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.1rem 0.6rem;
	}
	.line .row {
		flex: 1 1 18rem;
	}
	.line .rank,
	.line .done {
		flex-basis: 100%;
	}
	/* Stacked: a small card, one column, sized to its content. */
	.subscribe.stack {
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		margin-top: 0;
	}
	.stack .rank {
		grid-column: 1;
	}
	.stack input[type='email'] {
		flex-basis: 0;
	}
	@media (max-width: 640px) {
		.subscribe {
			grid-template-columns: minmax(0, 1fr);
		}
		.rank {
			grid-column: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.subscribe[data-rank='black'] .belt {
			animation: none;
		}
		.band,
		button {
			transition: none;
		}
	}
</style>
