---
/**
 * 띠 걸이 (belt rack): every LinkedIn recommendation hangs on the dojang wall
 * as a belt. Pick one off the rack to read the letter.
 */
import { RELATIONS, recommendations } from '../data/recommendations';

const BELT_COLORS = [
	{ c: '#cd2e3a', ink: '#ffffff' },
	{ c: '#0047a0', ink: '#ffffff' },
	{ c: '#0d0e10', ink: '#d8b45e' },
	{ c: '#e2b419', ink: '#0d0e10' },
	{ c: '#2f7a3b', ink: '#ffffff' },
];

const items = recommendations.map((r, i) => {
	const belt = BELT_COLORS[i % BELT_COLORS.length];
	const first = r.name.split(' ')[0];
	const initials = r.name
		.split(' ')
		.map((p) => p[0])
		.slice(0, 2)
		.join('');
	const year = r.date.slice(0, 4);
	// Deterministic, slightly different sway for each belt.
	const sd = (2.6 + ((i * 0.7) % 1.6)).toFixed(2);
	const sp = (-(i * 0.45)).toFixed(2);
	const tilt = (((i % 3) - 1) * 1.6 + 2.2).toFixed(1);
	return { ...r, belt, first, initials, year, sd, sp, tilt, rel: RELATIONS[r.relation] };
});
---

<section class="rack-sec" aria-labelledby="rack-heading" data-rack data-reveal>
	<div class="head">
		<p class="kicker">Recommendations</p>
		<h2 id="rack-heading">Pick a belt off the rack.</h2>
		<p class="muted intro">Each one is a real recommendation from LinkedIn.</p>
	</div>

	<div class="rack">
		<div class="bar" aria-hidden="true">
			<span class="plaque">{items.length} letters</span>
		</div>
		<div class="belts" role="tablist" aria-label="Recommendations">
			{
				items.map((r, i) => (
					<button
						type="button"
						role="tab"
						class="belt"
						id={`belt-tab-${i}`}
						aria-controls={`belt-letter-${i}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
						aria-label={`Letter ${i + 1}, from ${r.name}`}
						data-belt={i}
						style={`--c:${r.belt.c};--ink:${r.belt.ink};--sd:${r.sd}s;--sp:${r.sp}s;--tilt:${r.tilt}deg`}
					>
						<span class="sway" aria-hidden="true">
							<span class="peg" />
							<span class="loop" />
							<span class="knot" />
							<span class="tail l">
								<span class="name">{r.first}</span>
							</span>
							<span class="tail r" />
						</span>
					</button>
				))
			}
		</div>
	</div>

	<div class="controls">
		<button type="button" class="ctl" data-prev aria-label="Previous letter">←</button>
		<button type="button" class="ctl pick" data-random>
			Pick one for me
		</button>
		<button type="button" class="ctl" data-next aria-label="Next letter">→</button>
	</div>

	<div class="letters">
		{
			items.map((r, i) => (
				<article
					class="letter"
					role="tabpanel"
					id={`belt-letter-${i}`}
					aria-labelledby={`belt-tab-${i}`}
					hidden={i !== 0}
					data-letter={i}
					style={`--c:${r.belt.c};--ink:${r.belt.ink}`}
				>
					<div class="main">
						<blockquote class="pull">
							<p>
								{r.pull.split(' ').map((w, k) => (
									<span class="w" style={`--i:${k}`}>
										{w}{' '}
									</span>
								))}
							</p>
						</blockquote>
						<ul class="tags" aria-label="What this letter is about">
							{r.tags.map((t) => (
								<li>{t}</li>
							))}
						</ul>
						<button type="button" class="more" data-more aria-expanded="false" aria-controls={`belt-full-${i}`}>
							<span data-more-label>Read the full letter</span>
							<span aria-hidden="true" class="chev">
								↓
							</span>
						</button>
						<div class="full" id={`belt-full-${i}`} data-full>
							<div>
								{r.text.map((p) => (
									<p>{p}</p>
								))}
							</div>
						</div>
						<footer class="from">
							<span class="medal" aria-hidden="true">
								{r.initials}
							</span>
							<span class="who">
								<a href={r.linkedin} target="_blank" rel="noopener noreferrer" class="nm">
									{r.name} <span aria-hidden="true">↗</span>
									<span class="sr-only">(LinkedIn, opens in a new tab)</span>
								</a>
								<span class="role">{r.role}</span>
								<span class="rel">{r.relationNote}</span>
							</span>
						</footer>
					</div>
					<div class="band">
						<span class="no" aria-hidden="true">
							No. {String(i + 1).padStart(2, '0')}
						</span>
						<span class="rank">{r.rel.en}</span>
						<span class="seal" role="img" aria-label={`${r.org ? r.org + ', ' : ''}${r.year}`}>
							<span class="yr">{r.year}</span>
							{r.org && <span class="org">{r.org}</span>}
						</span>
					</div>
				</article>
			))
		}
	</div>
	<p class="sr-only" aria-live="polite" data-live></p>
</section>

<script>
	import { tick, whoosh } from '../lib/sound';

	function init() {
		const root = document.querySelector<HTMLElement>('[data-rack]');
		if (!root || root.dataset.ready) return;
		root.dataset.ready = '1';
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-belt]')];
		const letters = [...root.querySelectorAll<HTMLElement>('[data-letter]')];
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;
		let spinning = false;

		function select(i: number, { focus = false, sound = true } = {}) {
			i = (i + tabs.length) % tabs.length;
			tabs.forEach((t, k) => {
				const on = k === i;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				t.classList.remove('peek');
			});
			letters.forEach((l, k) => {
				l.hidden = k !== i;
				l.classList.remove('enter');
			});
			const tab = tabs[i];
			tab.classList.remove('whip');
			void tab.offsetWidth;
			tab.classList.add('whip');
			const letter = letters[i];
			void letter.offsetWidth;
			letter.classList.add('enter');
			if (focus) tab.focus();
			if (sound && i !== current) whoosh();
			current = i;
			live.textContent = '';
		}

		tabs.forEach((t, i) => t.addEventListener('click', () => !spinning && select(i)));

		root.querySelector('[role=tablist]')!.addEventListener('keydown', (e) => {
			const k = (e as KeyboardEvent).key;
			const map: Record<string, number> = {
				ArrowRight: current + 1,
				ArrowDown: current + 1,
				ArrowLeft: current - 1,
				ArrowUp: current - 1,
				Home: 0,
				End: tabs.length - 1,
			};
			if (k in map) {
				e.preventDefault();
				select(map[k], { focus: true });
			}
		});

		root.querySelector('[data-prev]')!.addEventListener('click', () => !spinning && select(current - 1));
		root.querySelector('[data-next]')!.addEventListener('click', () => !spinning && select(current + 1));

		// Roulette: the highlight runs along the rack, slows down, and lands.
		root.querySelector('[data-random]')!.addEventListener('click', () => {
			if (spinning) return;
			let target = Math.floor(Math.random() * tabs.length);
			if (target === current) target = (target + 1 + Math.floor(Math.random() * (tabs.length - 1))) % tabs.length;
			if (reduced) {
				select(target);
				live.textContent = `Picked the letter from ${tabs[target].getAttribute('aria-label')?.split('from ')[1]}.`;
				return;
			}
			spinning = true;
			const steps = tabs.length * 2 + ((target - current + tabs.length) % tabs.length);
			let step = 0;
			let pos = current;
			const run = () => {
				tabs[pos].classList.remove('peek');
				pos = (pos + 1) % tabs.length;
				tabs[pos].classList.add('peek');
				tick();
				step += 1;
				if (step >= steps) {
					spinning = false;
					select(target);
					live.textContent = `Picked the letter from ${tabs[target].getAttribute('aria-label')?.split('from ')[1]}.`;
					return;
				}
				const left = steps - step;
				setTimeout(run, left < 6 ? 70 + (6 - left) * 55 : 55);
			};
			run();
		});

		root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((b) => {
			b.addEventListener('click', () => {
				const open = b.getAttribute('aria-expanded') !== 'true';
				b.setAttribute('aria-expanded', String(open));
				b.querySelector('[data-more-label]')!.textContent = open ? 'Fold the letter' : 'Read the full letter';
				tick();
			});
		});
	}

	document.addEventListener('astro:page-load', init);
</script>

<style>
	.rack-sec {
		margin: 6rem 0;
	}
	.head {
		max-width: 38rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.6rem, 4vw, 2.25rem);
	}
	.intro {
		font-size: 1.05rem;
	}

	/* The wall rack: a dark wooden bar with belts hanging from pegs. */
	.rack {
		position: relative;
		margin: 2.5rem auto 0;
		max-width: 46rem;
	}
	.bar {
		position: relative;
		height: 1.6rem;
		border-radius: 4px;
		background:
			repeating-linear-gradient(
				92deg,
				transparent 0 9px,
				color-mix(in srgb, #000 18%, transparent) 9px 10px,
				transparent 10px 23px
			),
			linear-gradient(#7b5a37, #5b4027);
		box-shadow:
			0 10px 18px -10px rgb(0 0 0 / 0.55),
			inset 0 1px 0 rgb(255 255 255 / 0.18);
		display: grid;
		place-items: center;
	}
	.plaque {
		padding: 0.05rem 0.6rem;
		background: #e9d9b6;
		color: #3b2a17;
		border-radius: 2px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		box-shadow: 0 1px 0 rgb(0 0 0 / 0.3);
	}
	.plaque span {
		letter-spacing: 0.02em;
		font-family: var(--font-display);
	}
	.belts {
		display: flex;
		justify-content: space-around;
		gap: 0.25rem;
		padding: 0 0.5rem;
		margin-top: -0.55rem;
		min-height: 12rem;
	}
	.belt {
		position: relative;
		width: 3.4rem;
		height: 12rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		color: inherit;
		transition:
			opacity 0.3s,
			transform 0.35s var(--ease-press);
	}
	.belt:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 6px;
	}
	.belts:has([aria-selected='true']) .belt:not([aria-selected='true']):not(.peek) {
		opacity: 0.6;
	}
	.belt:hover,
	.belt.peek {
		opacity: 1 !important;
		transform: translateY(-4px);
	}
	.belt[aria-selected='true'] {
		transform: translateY(-6px);
	}
	.sway {
		position: absolute;
		inset: 0;
		transform-origin: 50% 0.6rem;
		animation: sway var(--sd) ease-in-out var(--sp) infinite alternate;
	}
	.whip .sway {
		animation:
			whip 0.9s cubic-bezier(0.3, 0.7, 0.4, 1),
			sway var(--sd) ease-in-out 0.9s infinite alternate;
	}
	@keyframes sway {
		from {
			transform: rotate(calc(var(--tilt) * -1));
		}
		to {
			transform: rotate(var(--tilt));
		}
	}
	@keyframes whip {
		0% {
			transform: rotate(0);
		}
		20% {
			transform: rotate(16deg);
		}
		45% {
			transform: rotate(-10deg);
		}
		70% {
			transform: rotate(5deg);
		}
		100% {
			transform: rotate(calc(var(--tilt) * -1));
		}
	}
	.peg {
		position: absolute;
		left: 50%;
		top: 0.2rem;
		width: 0.7rem;
		height: 0.7rem;
		translate: -50% 0;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #d8c39a, #8a6a42);
		z-index: 3;
	}
	.loop,
	.knot,
	.tail {
		position: absolute;
		background:
			repeating-linear-gradient(90deg, transparent 0 4px, rgb(255 255 255 / 0.07) 4px 5px),
			var(--c);
		box-shadow:
			inset 0 0 0 1px rgb(0 0 0 / 0.18),
			0 4px 8px -4px rgb(0 0 0 / 0.45);
	}
	.loop {
		left: 50%;
		top: 0.15rem;
		width: 2.1rem;
		height: 1.9rem;
		translate: -50% 0;
		border-radius: 0.9rem 0.9rem 0.3rem 0.3rem;
		z-index: 1;
	}
	.knot {
		left: 50%;
		top: 1.55rem;
		width: 1.7rem;
		height: 1.45rem;
		translate: -50% 0;
		border-radius: 3px;
		z-index: 2;
		background:
			linear-gradient(135deg, transparent 46%, rgb(0 0 0 / 0.18) 47% 53%, transparent 54%),
			var(--c);
	}
	.tail {
		top: 2.6rem;
		width: 1.15rem;
		border-radius: 0 0 2px 2px;
		transform-origin: 50% 0;
	}
	.tail.l {
		left: calc(50% - 1.1rem);
		height: 8.6rem;
		transform: rotate(5deg);
		z-index: 1;
	}
	.tail.r {
		left: calc(50% - 0.05rem);
		height: 7.4rem;
		transform: rotate(-6deg);
	}
	/* A gold rank bar near the end of each tail. */
	.tail::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.7rem;
		height: 0.3rem;
		background: #d8b45e;
		opacity: 0.9;
	}
	.name {
		position: absolute;
		top: 0.95rem;
		left: 50%;
		translate: -50% 0;
		writing-mode: vertical-rl;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
		white-space: nowrap;
	}
	/* Keep dark belts visible against a dark wall. */
	:global(:root[data-theme='dark']) .loop,
	:global(:root[data-theme='dark']) .knot,
	:global(:root[data-theme='dark']) .tail {
		outline: 1px solid rgb(255 255 255 / 0.16);
		outline-offset: -1px;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .loop,
		:global(:root:not([data-theme='light'])) .knot,
		:global(:root:not([data-theme='light'])) .tail {
			outline: 1px solid rgb(255 255 255 / 0.16);
			outline-offset: -1px;
		}
	}
	.belt[aria-selected='true'] .knot {
		box-shadow:
			0 0 0 2px var(--surface),
			0 0 0 4px var(--accent);
	}

	.controls {
		display: flex;
		justify-content: center;
		gap: 0.6rem;
		margin: 1.5rem 0 2rem;
	}
	.ctl {
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding: 0 0.9rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
		transition:
			border-color 0.2s,
			transform 0.15s;
	}
	.ctl:hover {
		border-color: var(--accent);
	}
	.ctl:active {
		transform: scale(0.96);
	}
	.pick .ko {
		color: var(--accent);
		font-size: 0.85rem;
		margin-left: 0.25rem;
	}

	/* The letter: a card with a belt-coloured band down the side. */
	.letter {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 7.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.45);
	}
	.letter[hidden] {
		display: none;
	}
	.letter.enter {
		animation: rise 0.6s var(--ease-press);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px) rotate(-0.6deg);
		}
	}
	.main {
		padding: clamp(1.4rem, 4vw, 2.5rem);
		min-width: 0;
	}
	.kick {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		margin: 0 0 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.kick .ko {
		color: var(--accent);
		letter-spacing: 0.04em;
		font-size: 0.9rem;
	}
	.pull {
		margin: 0;
		padding: 0;
		border: 0;
		color: var(--text);
	}
	.pull p {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 3vw, 1.85rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}
	.pull p::before {
		content: '“';
		color: var(--accent);
		margin-right: 0.05em;
	}
	.pull p::after {
		content: '”';
		color: var(--accent);
	}
	.enter .w {
		display: inline-block;
		white-space: pre;
		animation: word 0.5s cubic-bezier(0.2, 0.8, 0.3, 1) both;
		animation-delay: calc(var(--i) * 28ms + 120ms);
	}
	@keyframes word {
		from {
			opacity: 0;
			transform: translateY(0.4em);
			filter: blur(3px);
		}
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}
	.tags li {
		padding: 0.15rem 0.65rem;
		border: 1px solid var(--border);
		border-left: 4px solid var(--c);
		border-radius: 3px;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--muted);
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.25rem;
		padding: 0.35rem 0;
		border: 0;
		background: none;
		color: var(--accent);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
	}
	.chev {
		transition: transform 0.3s var(--ease-press);
	}
	.more[aria-expanded='true'] .chev {
		transform: rotate(180deg);
	}
	.full {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s cubic-bezier(0.3, 0.7, 0.3, 1);
	}
	.full > div {
		overflow: hidden;
	}
	.more[aria-expanded='true'] + .full {
		grid-template-rows: 1fr;
	}
	.full p {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.65;
	}
	.full > div > :first-child {
		padding-top: 0.25rem;
	}
	.from {
		display: flex;
		gap: 0.9rem;
		align-items: center;
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--border);
	}
	.medal {
		flex: none;
		display: grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 50%;
		background: var(--bg);
		box-shadow:
			0 0 0 3px var(--surface),
			0 0 0 6px var(--c);
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.05rem;
	}
	.who {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
		line-height: 1.4;
	}
	.nm {
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
	}
	.nm:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.role,
	.rel {
		font-size: 0.85rem;
		color: var(--muted);
	}
	.rel {
		font-style: italic;
	}

	.band {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 1.5rem 0.5rem;
		background:
			repeating-linear-gradient(90deg, transparent 0 6px, rgb(255 255 255 / 0.06) 6px 7px),
			var(--c);
		color: var(--ink);
		text-align: center;
	}
	.no {
		font-family: var(--font-display);
		font-weight: 600;
		writing-mode: vertical-rl;
		letter-spacing: 0.2em;
		font-size: 0.85rem;
		opacity: 0.85;
	}
	.rank {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.5rem;
		writing-mode: vertical-rl;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
