---
import FormattedDate from './FormattedDate.astro';
import { type Post, postUrl } from '../lib/posts';

interface Props {
	posts: Post[];
	showDescription?: boolean;
}
const { posts, showDescription = true } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={postUrl(post)}>{post.data.title}</a>
				{showDescription && <p class="desc">{post.data.description}</p>}
				<span class="date">
					<FormattedDate date={post.data.pubDate} />
				</span>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}
	li:last-child {
		border-bottom: 0;
	}
	a {
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--text);
		text-decoration: none;
		line-height: 1.35;
	}
	a:hover {
		color: var(--accent);
	}
	.desc {
		margin: 0.3rem 0 0.25rem;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.55;
	}
	.date {
		display: block;
		color: var(--muted);
		font-size: 0.875rem;
		margin-top: 0.2rem;
	}
</style>
