---
/**
 * Toon Uma in 3D, full body, doing airborne Taekwondo techniques. Every so
 * often he leaps in from the left or right edge, strikes, and leaps back out
 * the same side. Spins and turns happen in real 3D (Three.js, toon-shaded with
 * ink outlines to match the site's drawings).
 *
 * Three.js only loads the first time he appears, so it costs nothing on page
 * load. Decorative: hidden from screen readers, never takes clicks, and
 * switched off when the visitor prefers reduced motion or WebGL isn't there.
 */
---

<div class="kb-layer" aria-hidden="true" transition:persist="kick-buddy"></div>

<script>
	import { whoosh } from '../lib/sound';
	import { addToonLights, buildToon } from '../lib/toon3d';

	// A pose: body roll (r) and turn (y) in degrees, and each joint's swing in
	// the side-on plane, like the old 2D drawing: thighs (tf/tb), shins (sf/sb)
	// and arms (af/ab), front and back. 0 points straight down.
	type Pose = { r: number; y: number; tf: number; sf: number; tb: number; sb: number; af: number; ab: number };
	type Key = Partial<Pose> & { at: number };

	// In the air between moves: knees tucked, guard up.
	const TUCK: Pose = { r: -8, y: 0, tf: -70, sf: 110, tb: -20, sb: 120, af: -120, ab: -60 };

	// Every technique is airborne. Keys run 0..1 over the moment of the move.
	// `y` turns the whole body, so spins really spin.
	const MOVES: { name: string; keys: Key[] }[] = [
		{
			name: 'Flying side kick',
			keys: [{ at: 0 }, { at: 0.35, r: -28, y: -30, tf: -100, sf: 0, tb: -40, sb: 115, af: -135, ab: 30 }, { at: 0.75, r: -28, y: -30, tf: -100, sf: 0, tb: -40, sb: 115, af: -135, ab: 30 }, { at: 1 }],
		},
		{
			name: 'Jumping front kick',
			keys: [{ at: 0 }, { at: 0.35, r: -6, y: 35, tf: -92, sf: 0, af: -30, ab: -20 }, { at: 0.75, r: -6, y: 35, tf: -92, sf: 0, af: -30, ab: -20 }, { at: 1 }],
		},
		{
			name: 'Jumping back kick',
			keys: [{ at: 0 }, { at: 0.3, y: 180 }, { at: 0.5, y: 180, r: -14, tf: -92, sf: 0, af: -40, ab: -100 }, { at: 0.78, y: 180, r: -14, tf: -92, sf: 0, af: -40, ab: -100 }, { at: 1, y: 180 }],
		},
		{
			name: '360 spin kick',
			keys: [{ at: 0 }, { at: 0.25, y: 120, tf: -95, sf: 0 }, { at: 0.5, y: 240, tf: -100, sf: 0, af: -140 }, { at: 0.75, y: 330, tf: -95, sf: 0 }, { at: 1, y: 360 }],
		},
		{
			name: 'Jumping spinning kick',
			keys: [{ at: 0 }, { at: 0.3, y: 140, r: -10 }, { at: 0.52, y: 270, r: -20, tf: -100, sf: 100 }, { at: 0.66, y: 330, r: -22, tf: -100, sf: 0, af: -130 }, { at: 0.82, y: 360, tf: -100, sf: 0, r: -22 }, { at: 1, y: 360 }],
		},
		{
			name: 'Jumping punch',
			keys: [{ at: 0 }, { at: 0.3, y: 20, af: -90, ab: 40, r: -4 }, { at: 0.42, y: -15, af: -40, ab: -90 }, { at: 0.56, y: 20, af: -90, ab: 40 }, { at: 0.7, y: -15, af: -40, ab: -90 }, { at: 1 }],
		},
		{
			name: 'Butterfly kick',
			keys: [{ at: 0 }, { at: 0.5, r: -200, y: 160, tf: -60, sf: 0, tb: 70, sb: 0, af: -150, ab: 120 }, { at: 0.9, r: -360, y: 340, tf: -60, sf: 0, tb: 70, sb: 0, af: -150, ab: 120 }, { at: 1, r: -368, y: 360 }],
		},
	];

	// Fly in tucked, do the move, fly out tucked. `from`/`to` say where the
	// move sits in the whole animation. Full turns keep their final angle so
	// they don't unwind on the way out.
	function sequence(move: Key[], from = 0.32, to = 0.74): Key[] {
		const span = to - from;
		const last = move.at(-1)!;
		const end: Key = { at: 1, ...(last.r !== undefined ? { r: last.r } : {}), ...(Math.abs(last.y ?? 0) >= 360 ? { y: last.y } : {}) };
		return [{ at: 0 }, { at: from }, ...move.slice(1, -1).map((k) => ({ ...k, at: from + k.at * span })), { ...last, at: to }, end];
	}

	// The pose at time t (0..1): eased between the surrounding keys.
	const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - (-2 * x + 2) ** 2 / 2);
	function poseAt(keys: Key[], t: number): Pose {
		let i = 0;
		while (i < keys.length - 2 && t > keys[i + 1].at) i++;
		const a = { ...TUCK, ...keys[i] };
		const b = { ...TUCK, ...keys[i + 1] };
		const span = keys[i + 1].at - keys[i].at || 1;
		const k = ease(Math.min(1, Math.max(0, (t - keys[i].at) / span)));
		const out = {} as Pose;
		for (const p of Object.keys(TUCK) as (keyof Pose)[]) out[p] = a[p] + (b[p] - a[p]) * k;
		return out;
	}

	// ── The 3D fighter, built once and reused for every visit ──
	type Rig = {
		render: (pose: Pose, face: number) => void;
		canvas: HTMLCanvasElement;
	};
	let rigPromise: Promise<Rig | null> | null = null;

	function loadRig(size: number): Promise<Rig | null> {
		rigPromise ??= import('three')
			.then((THREE) => buildRig(THREE, size))
			.catch(() => null);
		return rigPromise;
	}

	function buildRig(THREE: typeof import('three'), size: number): Rig | null {
		const canvas = document.createElement('canvas');
		let renderer: import('three').WebGLRenderer;
		try {
			renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		} catch {
			return null;
		}
		renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
		renderer.setSize(size, size, false);

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 20);
		// A three-quarter view, a little from above, so depth reads.
		camera.position.set(0.95, 0.45, 2.85);
		camera.lookAt(0, 0.12, 0);
		addToonLights(THREE, scene);
		const t = buildToon(THREE, { legs: true });
		scene.add(t.body);

		const rad = THREE.MathUtils.degToRad;
		return {
			canvas,
			render(p, face) {
				// Facing left is a half turn; everything else is the pose.
				t.body.rotation.set(0, rad(p.y) + (face < 0 ? Math.PI : 0), -rad(p.r), 'YXZ');
				t.front.hip!.rotation.z = -rad(p.tf);
				t.front.knee!.rotation.z = -rad(p.sf);
				t.back.hip!.rotation.z = -rad(p.tb);
				t.back.knee!.rotation.z = -rad(p.sb);
				t.front.arm.rotation.z = -rad(p.af);
				t.back.arm.rotation.z = -rad(p.ab);
				// Belt tails flutter in the air.
				const now = performance.now() / 1000;
				t.tails.forEach((tail, i) => (tail.rotation.z = 0.5 + Math.sin(now * 14 + i * 1.7) * 0.35));
				renderer.render(scene, camera);
			},
		};
	}

	// Shuffle-bag so every move comes up before any repeats.
	let bag: number[] = [];
	function nextMove() {
		if (!bag.length) bag = MOVES.map((_, i) => i).sort(() => Math.random() - 0.5);
		return MOVES[bag.pop()!];
	}

	const rand = (a: number, b: number) => a + Math.random() * (b - a);
	const CANVAS = 180;

	async function perform(face: number, path: Keyframe[], ms: number, size: number) {
		const layer = document.querySelector<HTMLElement>('.kb-layer');
		const rig = layer && (await loadRig(CANVAS));
		if (!layer || !rig) return;
		const move = nextMove();
		const keys = sequence(move.keys);

		const wrap = document.createElement('div');
		wrap.className = 'kb';
		wrap.style.setProperty('--size', `${size}px`);
		wrap.append(rig.canvas);
		const bubble = document.createElement('span');
		bubble.className = 'kb-bubble';
		wrap.append(bubble);
		layer.append(wrap);

		const flight = wrap.animate(path, { duration: ms, easing: 'linear', fill: 'forwards' });
		setTimeout(() => {
			bubble.textContent = move.name + '!';
			wrap.classList.add('talk');
			whoosh();
		}, 0.32 * ms);
		setTimeout(() => wrap.classList.remove('talk'), 0.74 * ms + 250);

		// Pose and draw every frame until the flight lands.
		const start = performance.now();
		await new Promise<void>((done) => {
			const frame = (now: number) => {
				const t = Math.min(1, (now - start) / ms);
				rig.render(poseAt(keys, t), face);
				if (t < 1) requestAnimationFrame(frame);
				else done();
			};
			requestAnimationFrame(frame);
		});
		await flight.finished.catch(() => {});
		wrap.remove();
	}

	// A visit: leap in from the left or right edge, strike, and leap back out
	// the same side.
	let visiting = false;
	async function visit() {
		if (visiting || document.hidden) return;
		visiting = true;
		const w = window.innerWidth;
		const h = window.innerHeight;
		const size = Math.min(170, Math.max(110, w * 0.11));
		const fromLeft = Math.random() < 0.5;
		const reach = Math.min(w * 0.22, 260);
		const off = fromLeft ? -size - 40 : w + 40;
		const tx = fromLeft ? rand(24, reach) : w - size - rand(24, reach);
		const ty = rand(0.15, 0.62) * h;
		const face = fromLeft ? 1 : -1;
		const at = (x: number, y: number) => `translate(${x}px, ${y}px)`;
		const path: Keyframe[] = [
			{ offset: 0, transform: at(off, ty + 40) },
			{ offset: 0.16, transform: at((off + tx) / 2, ty - 50) },
			{ offset: 0.32, transform: at(tx, ty) },
			{ offset: 0.74, transform: at(tx + face * 14, ty - 8) },
			{ offset: 0.88, transform: at((off + tx) / 2, ty - 50) },
			{ offset: 1, transform: at(off, ty + 40) },
		];
		try {
			await perform(face, path, 3600, size);
		} finally {
			visiting = false;
		}
	}

	function schedule() {
		setTimeout(async () => {
			await visit();
			schedule();
		}, rand(25000, 50000));
	}

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// In development, `__kickBuddy()` in the console brings him in now.
		if (import.meta.env.DEV) (window as unknown as { __kickBuddy?: () => void }).__kickBuddy = visit;
		setTimeout(async () => {
			await visit();
			schedule();
		}, rand(8000, 14000));
	}
</script>

<style is:global>
	.kb-layer {
		position: fixed;
		inset: 0;
		z-index: 40;
		pointer-events: none;
		overflow: hidden;
	}
	.kb {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--size);
	}
	.kb canvas {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.25));
	}
	.kb-bubble {
		position: absolute;
		bottom: 92%;
		left: 50%;
		translate: -50% 0;
		padding: 0.25rem 0.55rem;
		border: 1px solid var(--text);
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.2s,
			transform 0.3s var(--ease-press);
	}
	.kb.talk .kb-bubble {
		opacity: 1;
		transform: none;
	}
</style>
