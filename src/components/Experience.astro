---
/**
 * Career timeline from LinkedIn. Each stage's line is drawn in the colour of
 * the belt it earned, from yellow to black.
 */
const career = [
	{
		org: 'Provus',
		domain: 'Pricing & quoting',
		years: '2025 – now',
		role: 'Technical Architect',
		belt: 'var(--belt)',
		about: 'How products, prices, discounts and approvals turn into a signed deal.',
		points: [
			'Built the CPQ Express Next.js application end to end, from the application foundation to CI/CD with Woodpecker and Vercel.',
			'Built a standalone AI-assisted quoting application with .NET Core, Next.js, TypeScript, PostgreSQL and the Vercel AI SDK.',
			'Contributed to the Salesforce package and helped publish it on Salesforce AppExchange.',
			'Delivered critical capabilities in the enterprise Salesforce application, such as currency conversion.',
			'Wrote product blogs and supported product webinars with the marketing team.',
		],
	},
	{
		org: 'Definitive Healthcare',
		domain: 'Healthcare data',
		years: '2023 – 2025',
		role: 'Engineering Manager',
		belt: '#cd2e3a',
		about: 'Physician and provider data that commercial teams search and report on.',
		points: [
			'Combined engineering leadership with hands-on .NET work on Latitude, a healthcare application built on microservices.',
			'Built backend services in C#, .NET Core and Entity Framework over SQL Server, MongoDB and Elasticsearch for search and reporting.',
			'Built asynchronous reporting jobs that turn cohort definitions into reports in the background.',
			'Built a GraphQL API with Hot Chocolate for an Android app, joining legacy .NET data with newer PostgreSQL databases.',
			'Implemented declarative authorization with C# controller attributes to standardise access checks across products.',
			'Led the migration of critical services from on-premises to AWS and automated the deployment pipelines.',
			'Guided delivery, design, releases and technical debt, and helped with hiring and team development.',
		],
	},
	{
		org: 'Conga',
		domain: 'Revenue & incentives',
		years: '2019 – 2023',
		role: 'Principal Software Engineer',
		belt: '#0047a0',
		about: 'Incentive plans and revenue data, kept in sync across Salesforce and the platform.',
		points: [
			'Helped build a new cloud-agnostic .NET platform for quote-to-cash apps: CPQ, contract lifecycle and incentive management.',
			'Worked across the Schema Manager, Platform Data and Data Migration teams on foundational data services.',
			'Built core data services, platform search and tenant management, and optimised query performance.',
			'Built a document database on blob storage and Redis / Amazon ElastiCache.',
			'Worked with DevOps on platform infrastructure and Kubernetes deployments.',
			'Built reusable frontend components for the Salesforce-based CIM app that other teams adopted.',
			'Led technical design reviews and mentored engineers.',
		],
	},
	{
		org: 'Kovai.co',
		domain: 'Integration & docs SaaS',
		years: '2016 – 2019',
		role: 'Technical Lead',
		belt: '#2f7a3b',
		about: 'Monitoring business integrations, and knowledge bases teams write in.',
		points: [
			'Helped build Atomic Scope from inception: the whole Angular frontend and parts of the .NET Core backend.',
			'Led a team of five engineers across Atomic Scope and Document360.',
			'Contributed to the initial design and development of Document360 in Angular and .NET Core.',
			'Built backend capabilities for BizTalk360 in .NET Core on Azure, and published its image on Azure Marketplace.',
			'Set up continuous deployment with Azure DevOps and built configurable analytics dashboards.',
			'Ran technical sessions on C#, ASP.NET, Angular and design patterns.',
		],
	},
	{
		org: 'Lightcast',
		domain: 'Labour-market analytics',
		years: '2011 – 2016',
		role: 'Software Engineer → Lead Engineer',
		belt: '#e2b419',
		about: 'Job data aggregated from many sources and fed to customers.',
		points: [
			'Built RESTful APIs for Job Insights with a global team.',
			'Was a key contributor to the re-architecture of an analytics app, improving its performance.',
			'Built data aggregation jobs and maintained data feeds for internal and external customers.',
			'Built web apps for on-demand job feeds, and helped customers move from legacy systems.',
			'Designed API documentation that became the standard for other products.',
		],
	},
];

interface Props {
	/** Section number shown in the kicker. */
	n?: string;
	/** Show every role's full list of work, as on the résumé. */
	detailed?: boolean;
	/** 1 when this section is the page's main heading. */
	level?: 1 | 2;
}
const { n = '02', level = 2, detailed = false } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="exp" aria-labelledby="exp-heading" data-reveal>
	<p class="kicker"><span class="n">{n}</span> Experience</p>
	<Heading id="exp-heading" class="sec-h">Fifteen years, five belts.</Heading>

	<ol class="timeline" data-stagger>
		{
			career.map((c, i) => (
				<li style={`--belt:${c.belt}`} class:list={{ now: i === 0 }}>
					<span class="years">{c.years}</span>
					<span class="track" aria-hidden="true">
						<span class="dot" />
					</span>
					<div class="what">
						<h3>{c.role}</h3>
						<p class="org">
							{c.org} <span class="domain">· {c.domain}</span>
						</p>
						<p class="work">{c.about}</p>
						{detailed && (
							<ul class="points">
								{c.points.map((p) => (
									<li>{p}</li>
								))}
							</ul>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.exp {
		margin: 0 0 7rem;
	}
	.sec-h {
		margin: 0 0 2.5rem;
		font-size: clamp(1.9rem, 4.5vw, 3rem);
	}
	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 52rem;
	}
	.timeline > li {
		display: grid;
		grid-template-columns: 8.5rem 2rem minmax(0, 1fr);
		gap: 0 1rem;
	}
	.years {
		padding-top: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	/* Each segment of the line is the colour of the belt earned there. */
	.track {
		position: relative;
		display: flex;
		justify-content: center;
	}
	.track::before {
		content: '';
		position: absolute;
		top: 0.55rem;
		bottom: -0.55rem;
		width: 3px;
		border-radius: 2px;
		background: var(--belt);
	}
	.timeline > li:last-child .track::before {
		bottom: 0;
	}
	.dot {
		position: relative;
		margin-top: 0.35rem;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--belt);
	}
	.now .dot {
		background: var(--accent);
		border-color: var(--accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
	}
	.what {
		padding-bottom: 2.25rem;
	}
	h3 {
		margin: 0;
		font-size: 1.2rem;
		letter-spacing: -0.02em;
	}
	.org {
		margin: 0.15rem 0 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--blue);
	}
	.domain {
		color: var(--faint);
	}
	.work {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
	}
	.points {
		margin: 0.75rem 0 0;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.points li {
		display: list-item;
		margin-bottom: 0.35rem;
	}
	@media (max-width: 600px) {
		.timeline > li {
			grid-template-columns: 1.25rem minmax(0, 1fr);
		}
		.years {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding: 0 0 0.2rem;
		}
		.track {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.what {
			grid-column: 2;
		}
	}
</style>
